{
  "name": "devin-metrics",
  "version": "0.2.0",
  "description": "Activity, context and session observability across Devin sessions — local-only, no telemetry.",
  "author": { "name": "Icaro0310" },
  "repository": "https://github.com/Icaro0310/devin-assure",
  "license": "MIT",
  "keywords": ["devin", "metrics", "observability", "usage", "sessions.db"],
  "mcpServers": {
    "devin-metrics": {
      "command": "uvx",
      "args": ["--from", "devin-metrics[mcp]", "devin-metrics-mcp"]
    }
  }
}
